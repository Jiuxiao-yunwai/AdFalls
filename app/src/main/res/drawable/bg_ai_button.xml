<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient
                android:angle="315"
                android:endColor="@color/app_accent"
                android:startColor="@color/app_accent_gold" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:angle="315"
                android:endColor="@color/app_accent_glow"
                android:startColor="@color/app_accent_gold" />
            <stroke
                android:width="1dp"
                android:color="#FFF2D6" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
