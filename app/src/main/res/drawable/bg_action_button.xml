<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/app_control_light_disabled" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/app_accent_soft" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/app_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/app_control_light_pressed" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/app_accent" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/app_control_light" />
            <corners android:radius="10dp" />
            <stroke
                android:width="2dp"
                android:color="@color/app_accent" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/app_control_light" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="@color/app_surface_card_stroke" />
        </shape>
    </item>
</selector>
