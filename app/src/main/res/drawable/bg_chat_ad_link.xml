<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#293630" />
            <stroke
                android:width="1dp"
                android:color="#9BE4D0" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#202724" />
            <stroke
                android:width="1dp"
                android:color="#3E5D54" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
