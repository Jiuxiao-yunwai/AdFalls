<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/app_surface_dark_pressed" />
            <stroke
                android:width="1dp"
                android:color="@color/app_accent_soft" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/app_surface_link" />
            <stroke
                android:width="1dp"
                android:color="@color/app_surface_link_outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
