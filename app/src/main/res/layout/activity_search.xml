<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/search_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_dark_button"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_field"
            android:hint="搜索广告、标签或场景"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8C8C8C"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/search_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#9A9A9A"
        android:textSize="12sp"
        tools:text="当前频道：精选 · 可搜索标题、品牌、摘要和标签" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="22dp"
            tools:itemCount="3"
            tools:listitem="@layout/item_ad_small" />

        <TextView
            android:id="@+id/search_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="输入关键词，搜索标题、品牌、摘要或标签"
            android:textColor="#8C8C8C"
            android:textSize="14sp" />
    </FrameLayout>
</LinearLayout>
