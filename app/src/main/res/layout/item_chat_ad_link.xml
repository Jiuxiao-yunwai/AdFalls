<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_chat_ad_link"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/chat_ad_link_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#75CDB5"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="PixelBox" />

    <TextView
        android:id="@+id/chat_ad_link_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="学生党数码精简包" />

    <TextView
        android:id="@+id/chat_ad_link_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="2"
        android:textColor="#C8C8C8"
        android:textSize="12sp"
        tools:text="高性价比数码配件组合，适合校园通勤和学习场景。" />

    <TextView
        android:id="@+id/chat_ad_link_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:textColor="#9BE4D0"
        android:textSize="11sp"
        tools:text="#数码  #学生  #性价比" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="7dp"
        android:text="@string/chat_ad_link_open"
        android:textColor="#75CDB5"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
