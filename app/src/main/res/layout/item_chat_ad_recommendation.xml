<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_recommendation_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_chat_recommendation_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/chat_recommendation_title"
        android:textColor="#75CDB5"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/chat_message_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        tools:text="可以优先看看下面这些推荐。" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="@string/chat_recommendation_subtitle"
        android:textColor="#A7A7A7"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/chat_recommendation_links"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/chat_recommendation_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/chat_recommendation_empty"
        android:textColor="#A7A7A7"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
