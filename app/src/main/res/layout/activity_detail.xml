<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/back_button"
            android:layout_width="48dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_action_button"
            android:gravity="center"
            android:text="‹"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_channel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#1F7A68"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="精选" />

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#111111"
            android:textSize="27sp"
            android:textStyle="bold"
            tools:text="城市夜跑能量补给" />

        <TextView
            android:id="@+id/detail_brand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#646464"
            android:textSize="14sp"
            tools:text="PulseRun" />

        <FrameLayout
            android:id="@+id/detail_media_container"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="16dp">

            <FrameLayout
                android:id="@+id/detail_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#222222"
                tools:background="#222222" />

            <ImageButton
                android:id="@+id/detail_video"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_video_control_circle"
                android:contentDescription="播放"
                android:padding="15dp"
                android:scaleType="center"
                android:src="@drawable/ic_video_play"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/detail_mute"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_video_control_circle"
                android:contentDescription="静音"
                android:padding="6dp"
                android:scaleType="center"
                android:src="@drawable/ic_volume_off"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/detail_progress_panel"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="bottom"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ProgressBar
                    android:id="@+id/detail_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:max="10000"
                    android:progress="0"
                    android:progressDrawable="@drawable/bg_video_progress_white" />

                <TextView
                    android:id="@+id/detail_time"
                    android:layout_width="78dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="end"
                    android:text="0:00 / 0:00"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/detail_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#202020"
            android:textSize="16sp"
            tools:text="轻量运动补给和夜跑装备组合，为城市夜跑人群提供舒适、反光和便携体验。" />

        <TextView
            android:id="@+id/detail_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="3dp"
            android:textColor="#4A4A4A"
            android:textSize="15sp"
            tools:text="本广告围绕夜间运动安全、补水和轻装备展开，适合下班后跑步、校园夜跑和周末训练等场景。" />

        <TextView
            android:id="@+id/detail_tags"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#1F7A68"
            android:textSize="14sp"
            tools:text="#运动  #夜跑  #年轻人" />

        <TextView
            android:id="@+id/detail_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#777777"
            android:textSize="13sp"
            tools:text="曝光 42 · 点击 8 · 分享 3" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detail_like"
                style="@style/DetailActionButton"
                tools:text="点赞 12" />

            <TextView
                android:id="@+id/detail_favorite"
                style="@style/DetailActionButton"
                android:layout_marginStart="8dp"
                tools:text="收藏" />

            <TextView
                android:id="@+id/detail_share"
                style="@style/DetailActionButton"
                android:layout_marginStart="8dp"
                tools:text="分享" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
