<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_ad_card"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <androidx.media3.ui.PlayerView
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#222222"
            app:use_controller="false" />

        <ImageButton
            android:id="@+id/action_video"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_video_control_circle"
            android:contentDescription="播放"
            android:padding="14dp"
            android:scaleType="center"
            android:src="@drawable/ic_video_play"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/action_mute"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_video_control_circle"
            android:contentDescription="静音"
            android:padding="9dp"
            android:scaleType="center"
            android:src="@drawable/ic_volume_off"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/video_progress_panel"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/video_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0" />

            <TextView
                android:id="@+id/video_time"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:text="0:00 / 0:00"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/ad_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#6D6D6D"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ad_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#151515"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ad_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#454545"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ad_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#1F7A68"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/ad_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#777777"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/action_like"
            style="@style/AdActionButton" />

        <TextView
            android:id="@+id/action_favorite"
            style="@style/AdActionButton"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/action_share"
            style="@style/AdActionButton"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
