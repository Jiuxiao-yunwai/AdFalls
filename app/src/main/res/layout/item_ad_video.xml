<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_ad_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="12dp">

    <FrameLayout
        android:id="@+id/ad_media_container"
        android:layout_width="match_parent"
        android:layout_height="190dp">

        <FrameLayout
            android:id="@+id/ad_media"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_surface_dark"
            tools:background="@color/app_surface_dark" />

        <ImageButton
            android:id="@+id/action_video"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_video_control_circle"
            android:contentDescription="播放"
            android:padding="14dp"
            android:scaleType="center"
            android:src="@drawable/ic_video_play"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/action_mute"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_video_mute_circle"
            android:contentDescription="静音"
            android:padding="13dp"
            android:scaleType="center"
            android:src="@drawable/ic_volume_off"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/video_progress_panel"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:id="@+id/video_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:max="10000"
                android:progress="0"
                android:progressDrawable="@drawable/bg_video_progress_white" />

            <TextView
                android:id="@+id/video_time"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:text="0:00 / 0:00"
                android:textColor="@color/app_text_on_dark_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/ad_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_brand_chip"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/app_text_tertiary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="VoltBike" />

    <TextView
        android:id="@+id/ad_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/app_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="城市短途骑行体验" />

    <TextView
        android:id="@+id/ad_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/app_text_secondary"
        android:textSize="14sp"
        tools:text="短视频广告展示城市骑行路线和低碳通勤方案。" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ad_tags"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="36dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/app_accent_strong"
            android:textSize="13sp"
            tools:text="#骑行  #低碳  #通勤" />

        <TextView
            android:id="@+id/action_like"
            style="@style/AdInlineLikeButton"
            android:layout_marginStart="8dp"
            android:drawableStart="@drawable/ic_inline_like"
            tools:text="8" />
    </LinearLayout>

</LinearLayout>
