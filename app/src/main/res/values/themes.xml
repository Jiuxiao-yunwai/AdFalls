<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AdFalls" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/app_accent</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AdActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_action_button</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:minWidth">58dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/app_accent_on</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AdIconActionButton" parent="AdActionButton">
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/action_button_content</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:textColor">@color/action_button_content</item>
    </style>

    <style name="AdActionButtonSmall" parent="AdActionButton">
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="AdIconActionButtonSmall" parent="AdIconActionButton">
        <item name="android:drawablePadding">4dp</item>
        <item name="android:minWidth">50dp</item>
        <item name="android:paddingStart">7dp</item>
        <item name="android:paddingEnd">7dp</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="AdInlineLikeButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/inline_like_content</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/inline_like_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DetailActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_action_button</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/app_accent_on</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DetailIconActionButton" parent="DetailActionButton">
        <item name="android:drawablePadding">7dp</item>
        <item name="android:drawableTint">@color/action_button_content</item>
        <item name="android:textColor">@color/action_button_content</item>
    </style>
</resources>
